// Prisma schema — Inphantil Cloud
// Ciclo 1: base + autenticação + upload. Preparado para crescer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DEV
  ADMIN
  SELLER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(SELLER)
  isActive     Boolean  @default(true)
  // Exige troca de senha no próximo login (1º acesso ou após reset pelo DEV).
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotes         Quote[]
  shippingQuotes ShippingQuote[]

  @@index([role])
}

/// Registro simples de imagem — valida o ciclo de vida do upload já
/// neste ciclo (sem vínculo com catálogo ainda).
model Image {
  id        String   @id @default(cuid())
  url       String
  key       String   @unique // key do objeto no R2
  createdAt DateTime @default(now())
}

/// Rede de segurança: keys cujo delete no R2 falhou. A rotina de limpeza
/// tenta removê-las novamente e marca resolvedAt.
model OrphanImage {
  id         String    @id @default(cuid())
  key        String    @unique
  reason     String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt])
}

// ─────────────────────────────────────────────────────────────
// Orçamentos (catálogo próprio, separado do catálogo da loja)
// ─────────────────────────────────────────────────────────────

enum QuoteMeasureType {
  UNIDADE // vendido por peça — usa "quantidade"
  METRO_LINEAR // vendido por metro linear — usa "medida" (m)
  METRO_QUADRADO // vendido por metro quadrado — usa "medida" (m²)
}

/// Produto do catálogo de orçamentos. Preço fixo ou "editável"
/// (isPriceEditable = true → a vendedora digita o valor ao adicionar).
model QuoteProduct {
  id              Int              @id @default(autoincrement())
  sku             String?          @unique @db.VarChar(50)
  name            String           @db.VarChar(200)
  price           Decimal?         @db.Decimal(10, 2)
  isPriceEditable Boolean          @default(false)
  measureType     QuoteMeasureType @default(UNIDADE)
  dimensions      String?          @db.VarChar(100) // ex.: "1,88 x 0,88 m"
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  quoteItems      QuoteItem[]

  @@index([isActive])
}

model Quote {
  id                     Int       @id @default(autoincrement())
  customerName           String    @db.VarChar(200)
  sellerId               String
  seller                 User      @relation(fields: [sellerId], references: [id])
  installments           Int? // nº máx. de parcelas; o PDF mostra de 1x até aqui
  discountPercent        Decimal?  @db.Decimal(5, 2) // % de desconto do À VISTA
  discountFixed          Decimal   @default(0) @db.Decimal(10, 2) // desconto fixo R$ do À VISTA
  oneInstallmentDiscount Boolean   @default(false) // 4% só no à prazo 1x
  shippingZipCode        String?   @db.VarChar(10)
  shippingValue          Decimal   @default(0) @db.Decimal(10, 2)
  subtotal               Decimal   @default(0) @db.Decimal(10, 2)
  discountValue          Decimal   @default(0) @db.Decimal(10, 2)
  total                  Decimal   @default(0) @db.Decimal(10, 2) // subtotal + frete (cheio/à prazo)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  items                  QuoteItem[]

  @@index([sellerId])
  @@index([createdAt])
}

model QuoteItem {
  id             Int              @id @default(autoincrement())
  quoteId        Int
  quote          Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteProductId Int?
  quoteProduct   QuoteProduct?    @relation(fields: [quoteProductId], references: [id], onDelete: SetNull)
  // snapshot do produto no momento do orçamento
  sku         String           @db.VarChar(50)
  name        String           @db.VarChar(200)
  measureType QuoteMeasureType
  unitPrice   Decimal          @db.Decimal(10, 2)
  quantity    Int? // quando UNIDADE
  measure     Decimal?         @db.Decimal(10, 3) // quando METRO_*
  lineTotal   Decimal          @db.Decimal(10, 2)
  dimensions  String?          @db.VarChar(100)
  note        String?          @db.VarChar(500)

  @@index([quoteId])
}

// ─────────────────────────────────────────────────────────────
// Frete — solicitações de cotação de frete (rastreador)
// ─────────────────────────────────────────────────────────────

model ShippingQuote {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  // Solicitação (preenchido por quem cria)
  quoteDetails    String?
  customerName    String? @db.VarChar(150)
  customerCpf     String? @db.VarChar(14)
  customerZipCode String? @db.VarChar(10)
  customerAddress String? @db.VarChar(255)
  customerCity    String? @db.VarChar(100)
  customerState   String? @db.VarChar(2)

  // Cotação (preenchido pelo admin)
  carrierName       String?  @db.VarChar(150)
  volumeQuantity    Int?
  weight            String?  @db.VarChar(50)
  shippingValue     Decimal? @db.Decimal(10, 2)
  orderValue        Decimal? @db.Decimal(10, 2)
  deliveryDeadline  String?  @db.VarChar(50)
  hasWallProtector  Boolean  @default(false)
  wallProtectorSize String?
  hasRug            Boolean  @default(false)
  rugSize           String?  @db.VarChar(100)
  hasAccessories    Boolean  @default(false)
  accessoryQuantity Int?
  bedSize           String?  @db.VarChar(100)
  adminNotes        String?

  // Estado
  isRequested Boolean   @default(false)
  isConcluded Boolean   @default(false)
  concludedAt DateTime?

  @@index([createdById])
  @@index([isConcluded])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Catálogo (alimenta o mostruário público). Tabela única
// polimórfica por `category`.
// ─────────────────────────────────────────────────────────────

enum CatalogCategory {
  APLIQUE
  SINTETICO
  TECIDO_LENCOL
  PRONTA_ENTREGA
}

enum ProntaEntregaKind {
  LENCOL
  LENCOL_FRONHA
  VIROL
  VIROL_FRONHA
  FRONHA
}

enum ProntaTamanho {
  FRONHA
  BERCO
  JUNIOR
  SOLTEIRO
  SOLTEIRAO
  VIUVA
  CASAL
  QUEEN
  KING
}

model CatalogItem {
  id       String          @id @default(cuid())
  category CatalogCategory
  code     String          @db.VarChar(60)
  color    String          @db.VarChar(80)

  // Imagem no R2 (url pública + key para replace/destroy)
  imageUrl String?
  imageKey String?

  available Boolean @default(true)

  // Específicos por categoria (nulos/false quando não se aplicam):
  quantity   Int? // APLIQUE, PRONTA_ENTREGA
  fazExterno Boolean            @default(false) // SINTETICO (interno é sempre; externo é a exceção)
  cabana       Boolean          @default(false) // APLIQUE — também aparece em "Apliques para cabana"
  apenasTapete Boolean          @default(false) @map("tapete") // SINTETICO — se true, aparece SÓ no mostruário de tapetes (fora do de cama)
  prontaKind ProntaEntregaKind? // PRONTA_ENTREGA
  tamanho    ProntaTamanho? // PRONTA_ENTREGA (tamanho da cama)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([category, available])
}
